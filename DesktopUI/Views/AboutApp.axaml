<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:lang="clr-namespace:DesktopUI"
        mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="500"
        Width="400"
        Height="400"
        x:Class="DesktopUI.Views.AboutApp"
        CanResize="False"
        Icon="/Assets/IcoFiles/about.ico" Title="{x:Static lang:Strings.AboutAppMenu }">
        
        <Grid RowDefinitions="Auto, *">
            <StackPanel Orientation="Vertical" Spacing="10">
                <TextBlock Text="{x:Static lang:Strings.ProgName}"  FontSize="36" FontWeight="Heavy" FontFamily="Impact"  HorizontalAlignment="Center" VerticalAlignment="Center"></TextBlock>
                <Image Source="avares://DesktopUI/Assets/Icons/Darts2.png" Width="300" Height="300"></Image> 
                <Grid RowDefinitions="Auto,Auto">
                    <TextBlock Text="Autor: Matěj Prudil" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
                    <TextBlock Text="Verze: 2.0.0 Alpha" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                </Grid>
            </StackPanel>
        </Grid>
        
        
        
</Window>
 