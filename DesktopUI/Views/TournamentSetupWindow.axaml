<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DesktopUI.ViewModels"
        xmlns:lang="clr-namespace:DesktopUI"
        xmlns:tournament="clr-namespace:DesktopUI.ViewModels.Tournament"
        x:Class="DesktopUI.Views.TournamentSetupWindow"
        x:DataType="tournament:TournamentSetupViewModel"
        Title="{x:Static lang:Strings.TournamentPrepare}"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        Icon="/Assets/IcoFiles/tournament.ico"
        CanResize="False">
    
    <ScrollViewer>
        <StackPanel Margin="30" Spacing="20" HorizontalAlignment="Center">
            
            <TextBlock Text="{x:Static lang:Strings.TournamentMain}" FontSize="46" 
                       FontFamily="avares://DesktopUI/Assets/Fonts/#Showcard Gothic" 
                       HorizontalAlignment="Center" Margin="0,0,0,10"/>
            
            
            <StackPanel Orientation="Horizontal" Spacing="15" HorizontalAlignment="Center" Margin="0,0,0,10">
                <TextBlock Text="{x:Static lang:Strings.TournamentNumPlayers}" VerticalAlignment="Center" FontSize="16"/>
                <ComboBox SelectedItem="{Binding PlayerCount}" 
                          ItemsSource="{Binding AllowedPlayerCounts}" 
                          Width="80" HorizontalContentAlignment="Center"/>
            </StackPanel>

            <ItemsControl ItemsSource="{Binding Slots}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="80, 200" Margin="0,5">
                            <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center" FontSize="16"/>
                            <ComboBox Grid.Column="1" 
                                      ItemsSource="{Binding AvailablePlayers}" 
                                      SelectedItem="{Binding SelectedPlayer}"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding PlayerName}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            
            <Border Background="#22FF0000" 
                    BorderBrush="#AAFF5555" 
                    BorderThickness="1" 
                    CornerRadius="6" 
                    Padding="16,8" 
                    Margin="0,10,0,0"
                    MaxWidth="300"
                    IsVisible="{Binding HasError}"
                    HorizontalAlignment="Center">
        
                <TextBlock Text="{Binding ErrorMessage}" 
                           Foreground="#FF5555" 
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Center"/>
            </Border>

            <Button Content="{x:Static lang:Strings.ButtonGameOn}" Command="{Binding StartTournamentCommand}" 
                    Width="120" Height="40" FontSize="16"
                    HorizontalAlignment="Center" HorizontalContentAlignment="Center" Margin="0,20,0,0"/>
            
        </StackPanel>
    </ScrollViewer>
</Window>