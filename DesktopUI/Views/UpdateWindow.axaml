<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DesktopUI.ViewModels"
        x:DataType="vm:UpdateViewModel"
        x:Class="DesktopUI.Views.UpdateWindow"
        Icon="/Assets/IcoFiles/update_progress.ico"
        Title="Aktualizace aplikace"
        MaxWidth="400" MinHeight="200"
        SizeToContent="WidthAndHeight"
        CanResize="False"
        CanMinimize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SystemRegionBrush}">
        
    <Border Padding="24">
        <StackPanel Spacing="16">
            
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Image Source="/Assets/IcoFiles/update.ico" Width="24" Height="24"/>
                <TextBlock Text="K dispozici je nová aktualizace" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>
            
            <Border Background="{DynamicResource SystemAccentColorDark1}" 
                    HorizontalAlignment="Left" Padding="8,4" CornerRadius="4">
                <TextBlock Text="{Binding Version}" FontWeight="SemiBold" Foreground="White" FontSize="14"/>
            </Border>
            
            <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}" 
                    BorderBrush="{DynamicResource SystemControlDefaultBaseLowBrush}" 
                    BorderThickness="1" CornerRadius="8" Padding="12"
                    Height="150"
                    IsVisible="{Binding !IsDownloading}">
                <ScrollViewer>
                    <TextBlock Text="{Binding Changelog}" TextWrapping="Wrap" LineHeight="22"/>
                </ScrollViewer>
            </Border>
            
            <!-- Fáze 2: Průběh stahování (Zobrazí se po kliknutí na Stáhnout) -->
            <StackPanel Spacing="8" IsVisible="{Binding IsDownloading}" Margin="0,20,0,20">
                <Grid ColumnDefinitions="*, Auto">
                    <TextBlock Grid.Column="0" Text="Stahování aktualizace..." FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="1" Text="{Binding ProgressText}" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                </Grid>
                <ProgressBar Minimum="0" Maximum="100" Value="{Binding DownloadPercentage}" Height="6" CornerRadius="3"/>
            </StackPanel>
            
            <!-- Tlačítka -->
            <Grid ColumnDefinitions="Auto, *, Auto, Auto" Margin="0,10,0,0">
                
                <!-- Tlačítko Ručně (vlevo) - zobrazené pořád -->
                <Button Grid.Column="0" Content="Ručně" Command="{Binding ManualUpdateCommand}" 
                        Background="Transparent" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                
                <!-- Tlačítka Později a Stáhnout (vpravo) - viditelná PŘED stahováním -->
                <Button Grid.Column="2" Content="Později" Command="{Binding CloseCommand}" 
                        Background="Transparent" Margin="0,0,8,0"
                        IsVisible="{Binding !IsDownloading}"/>
                
                <Button Grid.Column="3" Content="Stáhnout" Command="{Binding DownloadCommand}" 
                        Background="{DynamicResource SystemAccentColor}" Foreground="White"
                        FontWeight="Bold" Padding="16,8" CornerRadius="4"
                        IsVisible="{Binding !IsDownloading}"/>

                <!-- Tlačítko Zrušit (vpravo) - viditelné BĚHEM stahování -->
                <Button Grid.Column="3" Content="Zrušit" Command="{Binding CancelDownloadCommand}" 
                        Background="Transparent" Foreground="#FF5555" FontWeight="SemiBold"
                        Padding="16,8" CornerRadius="4"
                        IsVisible="{Binding IsDownloading}"/>
                        
            </Grid>
            
        </StackPanel>
    </Border>
</Window>