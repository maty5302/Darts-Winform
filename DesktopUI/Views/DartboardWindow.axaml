<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DesktopUI.Views.DartboardWindow"
        Title="{x:Static lang:Strings.DartboardMain}" Width="800" Height="600"
        CanResize="False"
        CanMinimize="False"
        xmlns:lang="clr-namespace:DesktopUI"
        Icon="/Assets/IcoFiles/dartboard.ico">
        
    <Grid ColumnDefinitions="300,*" RowDefinitions="Auto,*">
        
        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" 
                   Text="{x:Static lang:Strings.DartboardMain}" 
                   FontSize="32" FontFamily="avares://DartsCounter/Assets/Fonts/#Sigmar One" FontWeight="Bold"
                   HorizontalAlignment="Center" 
                   Margin="0,15,0,5"/>

        <StackPanel Grid.Row="1" Grid.Column="0" Margin="20" Spacing="15" VerticalAlignment="Center">
            
            <TextBlock Text="{x:Static lang:Strings.DartboardCurrentRound}" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
            <TextBlock Name="ActivePlayerText" Text="{x:Static lang:Strings.DartboardUpNext}" FontSize="20" FontWeight="Bold"
                       Foreground="Green" HorizontalAlignment="Center" Margin="0,0,0,10"/>
            
            <Border BorderBrush="Gray" BorderThickness="1" Padding="10" CornerRadius="5">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <TextBlock Text="1." VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,10,0"/>
                    <ComboBox Name="Dart1TypeCombo" Grid.Column="1" HorizontalAlignment="Stretch"
                               SelectionChanged="OnDartTypeChanged" IsEnabled="False">
                        <ComboBoxItem Content="{x:Static lang:Strings.DartboardOutside}"/>
                        <ComboBoxItem Content="{x:Static lang:Strings.DartboardSingle}"/>
                        <ComboBoxItem Content="{x:Static lang:Strings.DartboardDouble}"/>
                        <ComboBoxItem Content="{x:Static lang:Strings.DartboardTreble}"/>
                    </ComboBox>
                    <TextBlock Name="Dart1ScoreText" Grid.Column="2" Text="--" VerticalAlignment="Center"
                                FontWeight="Bold" Margin="10,0,0,0" Width="35" TextAlignment="Right"/>
                </Grid>
            </Border>
            
            <Border BorderBrush="Gray" BorderThickness="1" Padding="10" CornerRadius="5">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <TextBlock Text="2." VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,10,0"/>
                    <ComboBox Name="Dart2TypeCombo" Grid.Column="1" HorizontalAlignment="Stretch"
                               SelectionChanged="OnDartTypeChanged" IsEnabled="False">
                        <ComboBoxItem Content="{x:Static lang:Strings.DartboardOutside}"/>
                        <ComboBoxItem Content="{x:Static lang:Strings.DartboardSingle}"/>
                        <ComboBoxItem Content="{x:Static lang:Strings.DartboardDouble}"/>
                        <ComboBoxItem Content="{x:Static lang:Strings.DartboardTreble}"/>
                    </ComboBox>
                    <TextBlock Name="Dart2ScoreText" Grid.Column="2" Text="--" VerticalAlignment="Center"
                                FontWeight="Bold" Margin="10,0,0,0" Width="35" TextAlignment="Right"/>
                </Grid>
            </Border>
            
            <Border BorderBrush="Gray" BorderThickness="1" Padding="10" CornerRadius="5">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <TextBlock Text="3." VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,10,0"/>
                    <ComboBox Name="Dart3TypeCombo" Grid.Column="1" HorizontalAlignment="Stretch"
                               SelectionChanged="OnDartTypeChanged" IsEnabled="False">
                        <ComboBoxItem Content="{x:Static lang:Strings.DartboardOutside}"/>
                        <ComboBoxItem Content="{x:Static lang:Strings.DartboardSingle}"/>
                        <ComboBoxItem Content="{x:Static lang:Strings.DartboardDouble}"/>
                        <ComboBoxItem Content="{x:Static lang:Strings.DartboardTreble}"/>
                    </ComboBox>
                    <TextBlock Name="Dart3ScoreText" Grid.Column="2" Text="--" VerticalAlignment="Center"
                                FontWeight="Bold" Margin="10,0,0,0" Width="35" TextAlignment="Right"/>
                </Grid>
            </Border>
            
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" Margin="0,15,0,0">
                <Button Name="ClearButton" Content="{x:Static lang:Strings.DartboardClear}" Click="OnClearClicked" Width="100" HorizontalContentAlignment="Center"/>
                <Button Name="ConfirmButton" Content="{x:Static lang:Strings.DartboardConfirm}" Click="OnConfirmClicked" Width="100" HorizontalContentAlignment="Center" IsEnabled="False"/>
            </StackPanel>
            <TextBlock Name="ScoreDisplay" Text="{x:Static lang:Strings.DartboardThrown}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,15,0,0"/>
        </StackPanel>
        
        <Image Name="DartboardImage" Grid.Row="1" Grid.Column="1"
               Source="avares://DartsCounter/Assets/dartboard.png"
               PointerPressed="OnDartboardPointerPressed"
               Width="450" Height="450"
               Stretch="Uniform" />
               
    </Grid>
</Window>