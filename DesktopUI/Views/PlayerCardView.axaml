<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DesktopUI.ViewModels"
             x:Class="DesktopUI.Views.PlayerCardView"
             x:DataType="vm:PlayerViewModel">
    
    <Border Background="#228B22" CornerRadius="2" Margin="10" Padding="10" 
            BorderBrush="DarkGreen" BorderThickness="1">
        <StackPanel>
            <TextBlock Text="{Binding Name}" FontStyle="Italic" FontSize="16" Foreground="Black"/>
            
            <TextBlock Text="{Binding ScoreText}" FontSize="42" FontWeight="Bold" Foreground="Black" 
                       HorizontalAlignment="Center" Margin="0,10"/>
            
            <Grid ColumnDefinitions="*, Auto">
                <TextBox x:Name="InputBox" Grid.Column="0" Background="Transparent" Margin="0,0,5,0" Text="{Binding CurrentThrow}" HorizontalContentAlignment="Center">
                    <TextBox.KeyBindings>
                        <KeyBinding Gesture="Enter" Command="{Binding SubmitThrowCommand}" />
                    </TextBox.KeyBindings>
                </TextBox>
                <!-- <Button Grid.Column="1" Content="=" Background="Black" Width="30" HorizontalContentAlignment="Center" Command="{Binding SubmitThrowCommand}"/> -->
            </Grid>
            
            <Grid ColumnDefinitions="*, Auto">
                <TextBlock Text="{Binding AverageText}" FontSize="12" Foreground="Black" Margin="0,5,0,0"/>
                <TextBlock Text="{Binding Checkout}" FontSize="12" Foreground="Black" Margin="0,5,0,0" HorizontalAlignment="Right"/>
            </Grid>
        </StackPanel>
    </Border>
    
</UserControl>