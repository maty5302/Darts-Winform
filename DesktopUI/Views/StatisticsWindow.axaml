<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DesktopUI.ViewModels"
        xmlns:lang="clr-namespace:DesktopUI"
        x:Class="DesktopUI.Views.StatisticsWindow"
        x:DataType="vm:StatisticsViewModel"
        Title="{x:Static lang:Strings.StatsMenu}" Width="380" Height="750"
        WindowStartupLocation="CenterScreen"
        CanResize="False"
        >

    <Window.Styles>
        <Style Selector="Border.Card">
            <Setter Property="Background" Value="{DynamicResource SystemRegionBrush}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlDefaultBaseLowBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="TextBlock.SectionHeader">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style Selector="TextBlock.StatLabel">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,16,8"/>
            <Setter Property="Foreground" Value="{DynamicResource SystemControlPageTextBaseMediumBrush}"/>
        </Style>
        <Style Selector="TextBlock.StatValue">
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </Window.Styles>

    <DockPanel>
        <ScrollViewer>
            <StackPanel Margin="24">
                
                <TextBlock Text="{x:Static lang:Strings.StatsMenu}" 
                           FontSize="32" 
                           FontWeight="Black" 
                           LetterSpacing="2"
                           HorizontalAlignment="Center" 
                           FontFamily="avares://DesktopUI/Assets/Fonts/#Showcard Gothic"
                           Margin="0,0,0,24"/>

                <!-- VYTVOŘENÍ HRÁČE -->
                <Border Classes="Card">
                    <StackPanel>
                        <TextBlock Text= "{x:Static lang:Strings.StatisticsCreatePlayer}" Classes="SectionHeader"/>
                        <Grid ColumnDefinitions="*, Auto">
                            <TextBox Grid.Column="0" Text="{Binding NewPlayerName}" PlaceholderText="Zadejte jméno..." Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="{x:Static lang:Strings.StatisticsCreateButton}" Command="{Binding CreatePlayerCommand}" VerticalAlignment="Center" Padding="16,6"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- SPRÁVA HRÁČE -->
                <Border Classes="Card">
                    <StackPanel>
                        <TextBlock Text="{x:Static lang:Strings.StatisticsManage}" Classes="SectionHeader"/>
                        
                        <!-- Výběr a Smazání -->
                        <Grid ColumnDefinitions="*, Auto" Margin="0,0,0,12">
                            <ComboBox Grid.Column="0" 
                                      ItemsSource="{Binding Players}" 
                                      SelectedItem="{Binding SelectedPlayer}"
                                      HorizontalAlignment="Stretch" 
                                      Margin="0,0,12,0">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding PlayerName}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Grid.Column="1" Content="{x:Static lang:Strings.StatisticsRemove}" Command="{Binding DeletePlayerCommand}" Background="#33FF0000" Foreground="#FF5555"/>
                        </Grid>

                        <!-- Přejmenování -->
                        <Grid ColumnDefinitions="*, Auto" Margin="0,0,0,20">
                            <TextBox Grid.Column="0" Text="{Binding RenamePlayerName}" Margin="0,0,12,0"/>
                            <Button Grid.Column="1" Content="{x:Static lang:Strings.StatisticsRename}" Command="{Binding RenamePlayerCommand}"/>
                        </Grid>

                        <!-- STATISTIKY (ZÁLOŽKY) -->
                        <TabControl>
                            <!-- TENTO ROK -->
                            <TabItem Header="Tento rok" FontSize="14">
                                <Grid ColumnDefinitions="Auto, *" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" Margin="0,16,0,0" HorizontalAlignment="Center">
                                    
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Static lang:Strings.StatisticsVictoryCount}" Classes="StatLabel"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Wins}" Classes="StatValue"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Největší zavření:" Classes="StatLabel"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding HighestOut}" Classes="StatValue"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Poslední průměr:" Classes="StatLabel"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Average}" Classes="StatValue"/>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="60+:" Classes="StatLabel"/>
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Sixty}" Classes="StatValue"/>

                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="100+:" Classes="StatLabel"/>
                                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Hundred}" Classes="StatValue"/>

                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="120+:" Classes="StatLabel"/>
                                    <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding Hundred20}" Classes="StatValue"/>

                                    <TextBlock Grid.Row="7" Grid.Column="0" Text="180:" Classes="StatLabel"/>
                                    <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding Hundred80}" Classes="StatValue" Foreground="#FF8C00"/>
                                </Grid>
                            </TabItem>
                            
                            <!-- PŘEDCHOZÍ ROKY (Historie) -->
                            <TabItem Header="Předchozí roky" FontSize="14">
                                <Grid ColumnDefinitions="Auto, *" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" Margin="0,16,0,0" HorizontalAlignment="Center">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static lang:Strings.StatisticsVictoryCount}" Classes="StatLabel"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding AllWins}" Classes="StatValue"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Max zavření (historie):" Classes="StatLabel"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding OldHighestOut}" Classes="StatValue"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Celkem 60+:" Classes="StatLabel"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding AllSixty}" Classes="StatValue"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Celkem 100+:" Classes="StatLabel"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding AllHundred}" Classes="StatValue"/>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Celkem 120+:" Classes="StatLabel"/>
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding AllHundred20}" Classes="StatValue"/>

                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Celkem 180:" Classes="StatLabel"/>
                                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding AllHundred80}" Classes="StatValue" Foreground="#FF8C00"/>
                                </Grid>
                            </TabItem>
                        </TabControl>
                    </StackPanel>
                </Border>

                <!-- ODZNAKY / ÚSPĚCHY -->
                <Border Classes="Card" Margin="0">
                    <StackPanel>
                        <WrapPanel HorizontalAlignment="Center" ItemWidth="50" ItemHeight="50" Margin="0,8,0,0">
                            <Border Background="#22FFD700" CornerRadius="25" Margin="4">
                                <TextBlock Text="🏆" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20"/>
                            </Border>
                            <Border Background="#22808080" CornerRadius="25" Margin="4">
                                <TextBlock Text="20" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                            </Border>
                            <Border Background="#22808080" CornerRadius="25" Margin="4">
                                <TextBlock Text="🏆" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" Opacity="0.5"/>
                            </Border>
                            <Border Background="#2200FF00" CornerRadius="25" Margin="4">
                                <TextBlock Text="🎯" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20"/>
                            </Border>
                            <Border Background="#2200FF00" CornerRadius="25" Margin="4">
                                <TextBlock Text="🎯" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20"/>
                            </Border>
                        </WrapPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>